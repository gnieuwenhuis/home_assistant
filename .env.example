# Template for the repo-root .env. Copy this file to .env and fill in a real
# value. .env is .gitignored — never commit it.
#
# HOME_ASSISTANT_TOKEN is a Home Assistant long-lived access token, used to
# query the live instance over its REST API while working on this config.
# Generate one from the HA UI: profile → Security → Long-lived access tokens.
# See the "Talking to the live Home Assistant" section of README.md.
#
# The base URL is not stored here; it is http://homeassistant.local:8123.

HOME_ASSISTANT_TOKEN=paste-your-long-lived-access-token-here
